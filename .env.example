# =============================================================================
# Light — Environment Configuration
# Copy to .env and fill in values. Never commit secrets.
# =============================================================================

# Mode: demo | live
PRIVAI_MODE=live

# API Server
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000

# Database — SQLite for local dev (no Docker required).
# For PostgreSQL with Docker: set
# DATABASE_URL=postgresql://privai:privai@localhost:5432/privai_agent?schema=public
# and change prisma provider to postgresql, then run db:push.
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars
BCRYPT_ROUNDS=12

# Extension pairing
EXTENSION_TOKEN_SECRET=change-me-extension-token-secret-32chars

# AI Provider: demo | openai | anthropic | gemini
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Agent thresholds
CONFIDENCE_THRESHOLD=0.75
MAX_AGENT_STEPS=40
ACTION_TIMEOUT_MS=15000

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Privacy
STORE_SCREENSHOTS=false
STORE_SENSITIVE_VALUES=false

# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=Light
